{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noEmit": true, "skipLibCheck": true,
    "esModuleInterop": true, "allowImportingTsExtensions": true, "types": ["node"]
  },
  "include": ["server", "src", "shared", "scripts", "tests", "vite.config.ts"]
}
