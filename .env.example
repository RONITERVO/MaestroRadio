# Keys stay on your local server. Also accepts GEMINI_API_KEY1, ... with no fixed limit.
GEMINI_API_KEYS=
# Optional existing local env file; only its key variables are read.
GEMINI_KEYS_FILE=
# Optional separate pools; otherwise the shared pool above is used.
PLANNER_API_KEYS=
LIVE_API_KEYS=
PLANNER_MODEL=gemini-3.5-flash-lite
LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
PORT=4317
# A smaller optional ceiling for an episode; actual model metadata is always checked.
CONTEXT_LIMIT=1048576
DATA_DIR=./data
